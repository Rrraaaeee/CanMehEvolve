Replaced the byte-by-byte swaps for 2-, 4- and 8-byte elements with `memcpy` plus `__builtin_bswap16/32/64`. The compiler turns each swap into a single load, byte-swap and store.

Behavior is unchanged:
- The early-return check is the same.
- `numElements` is still computed as a `FIT_UINT8`.
- Any other element size still goes through the original generic loop.

```cpp
void Decode::UpdateEndianness(FIT_UINT8 type, FIT_UINT8 size)
{
    if (((type & FIT_BASE_TYPE_ENDIAN_FLAG) == 0) ||
        ((archs[localMesgIndex] & FIT_ARCH_ENDIAN_MASK) == FIT_ARCH_ENDIAN_LITTLE))
        return;

    FIT_UINT8 typeSize = baseTypeSizes[type & FIT_BASE_TYPE_NUM_MASK];
    FIT_UINT8 numElements = size / typeSize;
    FIT_UINT8* p = fieldData;

    switch (typeSize)
    {
    case 2:
        for (int e = 0; e < numElements; e++, p += 2)
        {
            uint16_t v;
            std::memcpy(&v, p, 2);
            v = __builtin_bswap16(v);
            std::memcpy(p, &v, 2);
        }
        break;
    case 4:
        for (int e = 0; e < numElements; e++, p += 4)
        {
            uint32_t v;
            std::memcpy(&v, p, 4);
            v = __builtin_bswap32(v);
            std::memcpy(p, &v, 4);
        }
        break;
    case 8:
        for (int e = 0; e < numElements; e++, p += 8)
        {
            uint64_t v;
            std::memcpy(&v, p, 8);
            v = __builtin_bswap64(v);
            std::memcpy(p, &v, 8);
        }
        break;
    default:
        for (int e = 0; e < numElements; e++, p += typeSize)
        {
            for (int i = 0; i < (typeSize / 2); i++)
            {
                FIT_UINT8 t = p[i];
                p[i] = p[typeSize - i - 1];
                p[typeSize - i - 1] = t;
            }
        }
        break;
    }
}
```

