A smaller lookup table should be faster than the current 128 KB one. Message numbers below 1024 now use a 2 KB table, which stays resident in cache. Larger numbers fall back to a linear scan that returns the first match, so every result matches the original.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static FIT_UINT16 table[1024];
    static const bool initialized = []() {
        for (int k = 0; k < 1024; k++)
            table[k] = 0xFFFF;
        for (int i = MESGS - 1; i >= 0; i--)
        {
            FIT_UINT16 n = mesgs[i].num;
            if (n < 1024)
                table[n] = (FIT_UINT16)i;
        }
        return true;
    }();
    (void)initialized;

    if (num < 1024)
    {
        FIT_UINT16 idx = table[num];
        if (idx == 0xFFFF)
            return NULL;
        return &mesgs[idx];
    }

    for (int i = 0; i < MESGS; i++)
    {
        if (mesgs[i].num == num)
            return &mesgs[i];
    }
    return NULL;
}
```