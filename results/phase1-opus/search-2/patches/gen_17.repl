The original 64K-entry table takes 128 KB, so lookups spread across many cache lines. Profile message numbers are mostly small, so this version uses a dense 2 KB index for `num < 1024`. Larger numbers fall back to a linear scan.

The result is the same as before for every input:
- **Duplicate numbers:** the table is filled in reverse order, and the scan runs forward. Both give the first `mesgs` entry with a matching number, as the original did.
- **Unknown numbers:** these still return `NULL`.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    enum { SMALL = 1024 };
    struct Index
    {
        FIT_UINT16 idx[SMALL];
        Index()
        {
            for (int k = 0; k < SMALL; k++)
                idx[k] = 0xFFFF;
            for (int i = MESGS - 1; i >= 0; i--)
            {
                const FIT_UINT16 n = (FIT_UINT16)mesgs[i].num;
                if (n < SMALL)
                    idx[n] = (FIT_UINT16)i;
            }
        }
    };
    static const Index table;

    if (num < SMALL)
    {
        const FIT_UINT16 i = table.idx[num];
        if (i == 0xFFFF)
            return NULL;
        return &mesgs[i];
    }

    for (int i = 0; i < MESGS; i++)
    {
        if ((FIT_UINT16)mesgs[i].num == num)
            return &mesgs[i];
    }
    return NULL;
}
```