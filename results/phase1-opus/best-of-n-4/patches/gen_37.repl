This replaces the linear scan with a direct-index table for message numbers below 1024, built once on first call. Nums of 1024 and above keep the original linear scan.

- **Same results:** each table slot stores the first matching index, so the earlier entry still wins when nums are duplicated. Nums not in the profile still return `NULL`.
- **Not a mutable cache:** the table is built only from the constant `mesgs` array, and C++11 makes its one-time initialization thread-safe.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    enum { LOOKUP_SIZE = 1024 };
    struct Lookup
    {
        FIT_UINT16 idx[LOOKUP_SIZE];
        Lookup()
        {
            for (int k = 0; k < LOOKUP_SIZE; k++)
                idx[k] = 0xFFFF;
            for (int i = 0; i < MESGS; i++)
            {
                FIT_UINT16 n = mesgs[i].num;
                if (n < LOOKUP_SIZE && idx[n] == 0xFFFF)
                    idx[n] = (FIT_UINT16)i;
            }
        }
    };
    static const Lookup lookup;

    if (num < LOOKUP_SIZE)
    {
        FIT_UINT16 i = lookup.idx[num];
        if (i == 0xFFFF)
            return NULL;
        return &mesgs[i];
    }

    for (int i = 0; i < MESGS; i++)
    {
        if (mesgs[i].num == num)
            return &mesgs[i];
    }

    return NULL;
}
```