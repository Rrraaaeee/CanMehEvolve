The main changes:

- **Read the type once.** `GetType()` is called once instead of twice, and the base-type index is computed once.
- **Single load in the common case.** When the field's byte size equals `sizeof(T)` and the host is little-endian, the value is read with one `memcpy`. This gives the same result as the shift loop.
- **Unchanged fallback.** Every other case, including mismatched sizes and big-endian or unknown byte order, runs the original loop.
- **Same bounds behaviour.** The index check against `values.size()` is kept exactly as before.

```cpp
template <typename T>
T FieldBase::GetValue(const FIT_UINT8 fieldArrayIndex) const
{
    const FIT_UINT8 typeNum = GetType() & FIT_BASE_TYPE_NUM_MASK;
    const FIT_UINT8 size = baseTypeSizes[typeNum];
    if (fieldArrayIndex >= (FIT_UINT8)values.size())
    {
        return *reinterpret_cast<const T*>(baseTypeInvalids[typeNum]);
    }

    const size_t base = (size_t)fieldArrayIndex * size;

#if defined(__BYTE_ORDER__) && defined(__ORDER_LITTLE_ENDIAN__) && (__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__)
    if (sizeof(values[0]) == 1 && size == sizeof(T))
    {
        T rv;
        std::memcpy(&rv, &values[base], sizeof(T));
        return rv;
    }
#endif

    T rv = 0;

    for (int i = 0; i < size; i++)
    {
        rv |= static_cast<T>(values[base + i]) << (i * 8);
    }

    return rv;
}
```

