File: src/fit_field_base.cpp
Function: FieldBase::GetNumValues
One decode of the test corpus takes about 358.509 ms.
The code below currently runs at 0.912721 of the original SDK's decode time; the best found so far is 0.903124.

Rewrite this function to make decoding faster:
```cpp
FIT_UINT8 FieldBase::GetNumValues(void) const
{
    if (!IsValid())
        return 0;

    const FIT_UINT8 type = GetType();

    if (type != FIT_BASE_TYPE_STRING)
    {
        const size_t n = values.size();
        const FIT_UINT8 sz = baseTypeSizes[type & FIT_BASE_TYPE_NUM_MASK];
        switch (sz)
        {
        case 1: return (FIT_UINT8)n;
        case 2: return (FIT_UINT8)(n >> 1);
        case 4: return (FIT_UINT8)(n >> 2);
        case 8: return (FIT_UINT8)(n >> 3);
        default: return (FIT_UINT8)(n / sz);
        }
    }

    return (FIT_UINT8)stringIndexes.size();
}
```
