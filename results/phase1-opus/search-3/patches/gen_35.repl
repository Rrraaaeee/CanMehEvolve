The current version looks up a 128 KB table indexed by message number. That table has poor cache locality. Most FIT message numbers are below 1024, so this version uses a 2 KB table for those, which stays in L1 cache.

- **Numbers below 1024:** answered directly from the small table.
- **Numbers above the largest profile number:** return NULL immediately. This makes unknown manufacturer messages (e.g. 0xFFxx) cheap.
- **Numbers in between:** use the original linear scan, so the first match is still returned.

Results are unchanged for every input, because the table is filled in reverse order and so also keeps the first matching entry.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    enum { SMALL = 1024 };
    struct Index
    {
        FIT_UINT16 idx[SMALL];
        FIT_UINT16 maxNum;
        Index()
        {
            for (int k = 0; k < SMALL; k++)
                idx[k] = 0xFFFF;
            maxNum = 0;
            for (int i = MESGS - 1; i >= 0; i--)
            {
                const FIT_UINT16 n = mesgs[i].num;
                if (n < SMALL)
                    idx[n] = (FIT_UINT16)i;
                if (n > maxNum)
                    maxNum = n;
            }
        }
    };

    if (MESGS < 0xFFFF)
    {
        static const Index table;
        if (num < SMALL)
        {
            const FIT_UINT16 i = table.idx[num];
            if (i == 0xFFFF)
                return NULL;
            return &mesgs[i];
        }
        if (num > table.maxNum)
            return NULL;
    }

    for (int i = 0; i < MESGS; i++)
    {
        if (mesgs[i].num == num)
            return &mesgs[i];
    }

    return NULL;
}
```