The change replaces the per-call `switch` on the byte size with a lookup of a precomputed shift amount. Behaviour is unchanged:

- **Same results:** each in-table base type has a byte size of 1, 2, 4 or 8. The shift is computed from that same `baseTypeSizes` entry, so `n >> shift` gives exactly what `n / sz` would.
- **Unexpected sizes still divide:** an entry whose size is not 1, 2, 4 or 8 is marked 255 and uses the original division path.
- **Out-of-range indices are untouched:** they read `baseTypeSizes` as before.
- **No global mutable state:** the shift table is built once from `baseTypeSizes` at static initialisation and only read afterwards.

I have not measured the speed-up.

```cpp
FIT_UINT8 FieldBase::GetNumValues(void) const
{
    if (!IsValid())
        return 0;

    const FIT_UINT8 type = GetType();

    if (type == FIT_BASE_TYPE_STRING)
        return (FIT_UINT8)stringIndexes.size();

    const size_t n = values.size();
    const FIT_UINT8 idx = (FIT_UINT8)(type & FIT_BASE_TYPE_NUM_MASK);

    if (idx < FIT_BASE_TYPES)
    {
        struct ShiftTable
        {
            FIT_UINT8 s[FIT_BASE_TYPES];
            ShiftTable()
            {
                for (int i = 0; i < FIT_BASE_TYPES; i++)
                {
                    switch (baseTypeSizes[i])
                    {
                    case 1: s[i] = 0; break;
                    case 2: s[i] = 1; break;
                    case 4: s[i] = 2; break;
                    case 8: s[i] = 3; break;
                    default: s[i] = 255; break;
                    }
                }
            }
        };
        static const ShiftTable table;
        const FIT_UINT8 sh = table.s[idx];
        if (sh != 255)
            return (FIT_UINT8)(n >> sh);
    }

    const FIT_UINT8 sz = baseTypeSizes[idx];
    switch (sz)
    {
    case 1: return (FIT_UINT8)n;
    case 2: return (FIT_UINT8)(n >> 1);
    case 4: return (FIT_UINT8)(n >> 2);
    case 8: return (FIT_UINT8)(n >> 3);
    default: return (FIT_UINT8)(n / sz);
    }
}
```