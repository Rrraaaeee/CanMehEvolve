The main change: the original loop stepped through every skipped byte one at a time while `offset >= 8`, calling `GetSize()` on each pass. The rewrite does this instead:

- **Single size call:** `GetSize()` is called once, which assumes it is side-effect free (it is a `const` accessor).
- **Direct jump to the start byte:** it goes straight to byte `offset >> 3` with bit shift `offset & 7`. It returns invalid if that start byte is past the end, which is exactly the case where the original's skip loop would have run out of bytes.
- **Exact fallback for sizes over 255:** in that case the original's 8-bit `index` could wrap around, so the code falls back to the original loop to keep that behaviour unchanged.

```cpp
template <typename T>
T FieldBase::GetBitsValueT(const FIT_UINT16 offset, const FIT_UINT8 bits) const
{
    T value = 0;
    FIT_UINT8 numValueBits = 0;

    if (values.size() == 0)
        return FitInvalid<T>::value;

    if (bits == 0)
        return value;

    const auto size = GetSize();

    if (size <= 255)
    {
        const unsigned startIndex = (unsigned)(offset >> 3);
        if (startIndex >= (unsigned)size)
            return FitInvalid<T>::value;

        FIT_UINT8 index = (FIT_UINT8)startIndex;
        FIT_UINT8 bitOffset = (FIT_UINT8)(offset & 7);

        while (numValueBits < bits)
        {
            if (index >= size)
                return FitInvalid<T>::value;

            FIT_UINT8 data = GetValuesUINT8(index);
            data >>= bitOffset;
            FIT_UINT8 numDataBitsUsed = 8 - bitOffset;
            bitOffset = 0;

            if (numDataBitsUsed > (bits - numValueBits))
                numDataBitsUsed = bits - numValueBits;

            FIT_UINT8 mask = (1 << numDataBitsUsed) - 1;
            value |= (T)(data & mask) << numValueBits;
            numValueBits += numDataBitsUsed;
            index++;
        }
        return value;
    }

    // Fallback: original semantics (including 8-bit index wrap behavior)
    FIT_UINT8 numDataBitsUsed;
    FIT_UINT8 index = 0;
    FIT_UINT8 data;
    FIT_UINT8 mask;
    FIT_UINT16 newOffset = offset;

    while (numValueBits < bits)
    {
        if (index >= size)
            return FitInvalid<T>::value;

        if (newOffset >= 8)
        {
            newOffset -= 8;
        }
        else
        {
            data = GetValuesUINT8(index);
            data >>= newOffset;
            numDataBitsUsed = 8 - (FIT_UINT8)newOffset;
            newOffset = 0;

            if (numDataBitsUsed > (bits - numValueBits))
                numDataBitsUsed = bits - numValueBits;

            mask = (1 << numDataBitsUsed) - 1;
            value |= (T)(data & mask) << numValueBits;
            numValueBits += numDataBitsUsed;
        }
        index++;
    }

    return value;
}
```