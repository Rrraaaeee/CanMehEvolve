The original lookup table stores `FIT_SINT16` entries. This version uses one-byte entries, so the 1024-entry table shrinks from 2 KB to 1 KB. That takes up fewer cache lines during decoding.

- **Byte table:** each entry holds a message index, with `0xFF` meaning "no message with this number". It is only used when `MESGS < 255`.
- **Fallback:** if there are 255 or more messages, `lutLimit` is set to 0 and every lookup takes the existing sorted-range linear search. Results stay the same either way.
- **Branch hints:** the out-of-table path is marked as rare with `__builtin_expect`, which assumes GCC or Clang. Real message numbers are almost all below 1024.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    enum { LUT_SIZE = 1024 };
    struct Lut
    {
        unsigned char idx[LUT_SIZE];
        FIT_UINT32 lutLimit;   // LUT_SIZE if ok, else 0
        FIT_UINT32 hiMin;
        FIT_UINT32 hiMax;
        int hiFirst;
        Lut()
        {
            bool ok = (MESGS < 255);
            for (int k = 0; k < LUT_SIZE; k++)
                idx[k] = 0xFF;
            lutLimit = ok ? LUT_SIZE : 0;
            hiMin = 0xFFFFFFFFu;
            hiMax = 0;
            hiFirst = MESGS;
            for (int i = MESGS - 1; i >= 0; i--)
            {
                FIT_UINT16 n = mesgs[i].num;
                if (ok && n < LUT_SIZE)
                {
                    idx[n] = (unsigned char)i;
                }
                else
                {
                    if (n < hiMin) hiMin = n;
                    if (n > hiMax) hiMax = n;
                    hiFirst = i;
                }
            }
        }
    };
    static const Lut lut;

    if (__builtin_expect((FIT_UINT32)num < lut.lutLimit, 1))
    {
        unsigned int i = lut.idx[num];
        return (i != 0xFFu) ? &mesgs[i] : NULL;
    }

    if ((FIT_UINT32)num < lut.hiMin || (FIT_UINT32)num > lut.hiMax)
        return NULL;

    for (int i = lut.hiFirst; i < MESGS; i++)
    {
        if (mesgs[i].num == num)
            return &mesgs[i];
    }

    return NULL;
}
```