The current 128 KB lookup table is mostly empty, and it spreads lookups across many cache lines. This version shrinks it to a dense 2 KB table covering message numbers below 1024, which should stay in L1 cache. Profile message numbers are expected to fall in that range.

Any number at or above 1024 falls back to the original linear scan. Behavior is unchanged:
- The table is built in reverse order, so it still returns the first matching entry.
- Numbers that are absent still return `NULL`.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    enum { LUT_SIZE = 1024 };
    struct Lut
    {
        FIT_UINT16 idx[LUT_SIZE];
        bool ok;
        Lut() : idx(), ok(MESGS < 65535)
        {
            if (!ok)
                return;
            for (int i = MESGS - 1; i >= 0; i--)
            {
                unsigned n = mesgs[i].num;
                if (n < LUT_SIZE)
                    idx[n] = (FIT_UINT16)(i + 1);
            }
        }
    };
    static const Lut lut;

    if (num < LUT_SIZE && lut.ok)
    {
        unsigned i = lut.idx[num];
        return i ? &mesgs[i - 1] : NULL;
    }

    for (int i = 0; i < MESGS; i++)
    {
        if (mesgs[i].num == num)
            return &mesgs[i];
    }

    return NULL;
}
```