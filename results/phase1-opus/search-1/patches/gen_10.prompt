File: src/fit_profile.cpp
Function: Profile::GetMesg
One decode of the test corpus takes about 358.833 ms.
The code below currently runs at 0.938517 of the original SDK's decode time; the best found so far is 0.936544.

Rewrite this function to make decoding faster:
```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    struct Lut
    {
        FIT_UINT16 idx[65536];
        bool ok;
        Lut() : idx(), ok(MESGS < 65535)
        {
            if (!ok)
                return;
            for (int i = MESGS - 1; i >= 0; i--)
                idx[mesgs[i].num] = (FIT_UINT16)(i + 1);
        }
    };
    static const Lut lut;

    if (lut.ok)
    {
        unsigned i = lut.idx[num];
        return i ? &mesgs[i - 1] : NULL;
    }

    for (int i = 0; i < MESGS; i++)
    {
        if (mesgs[i].num == num)
            return &mesgs[i];
    }

    return NULL;
}
```
