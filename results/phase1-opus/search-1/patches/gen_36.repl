Changes:

- **Cache values once.** `GetType()` and the invalid-value pointer are read a single time instead of on every loop iteration.
- **Single-byte types get a fast path.** When `typeSize == 1`, a plain byte compare replaces the per-element `memcmp` call.
- **Bulk copy for strings.** One `assign` copies the bytes, instead of a `push_back` per byte. A separate scan then pushes the same string indexes as the original.
- **Behavior is unchanged.** The original multi-byte `memcmp` loop is kept as-is, including its edge cases (sizes that aren't a multiple of the type size, and `typeSize == 0`).

```cpp
FIT_BOOL FieldBase::Read(const void *data, const FIT_UINT8 size)
{
    const FIT_UINT8 type = GetType();
    const FIT_UINT8 typeSize = baseTypeSizes[type & FIT_BASE_TYPE_NUM_MASK];
    const FIT_BYTE *byteData = (const FIT_BYTE *) data;

    values.clear();

    if (type == FIT_BASE_TYPE_STRING)
    {
        FIT_UINT8 index = 0;

        // Check if the string is empty
        while (index < size)
        {
            if (byteData[index] != 0)
                break;
            index++;
        }

        if (index >= size)
            return FIT_TRUE;

        stringIndexes.push_back(0);

        values.assign(byteData, byteData + size);

        for (int i = 0; i < (int)size; i++)
        {
            if (byteData[i] == 0)
            {
                FIT_UINT8 stringPos = (FIT_UINT8)(i + 1);
                if (stringPos + 1 < size)
                    stringIndexes.push_back(stringPos);
            }
        }

        // Null terminate if not already null terminated
        if (values.back() != 0)
        {
            values.push_back(0);
        }
        return FIT_TRUE;
    }

    const FIT_BYTE *inv = (const FIT_BYTE *) baseTypeInvalids[type & FIT_BASE_TYPE_NUM_MASK];

    if (typeSize == 1)
    {
        const FIT_BYTE invByte = inv[0];
        for (int i = 0; i < (int)size; i++)
        {
            if (byteData[i] != invByte)
            {
                values.assign(byteData, byteData + size);
                break;
            }
        }
        return FIT_TRUE;
    }

    int bytes = size;
    const FIT_BYTE *point = byteData;

    while (bytes > 0)
    {
        if (memcmp(point, inv, typeSize) != 0)
        {
            values.assign(byteData, byteData + size);
            break;
        }
        point += typeSize;
        bytes -= typeSize;
    }

    return FIT_TRUE;
}
```