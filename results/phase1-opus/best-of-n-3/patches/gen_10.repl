The per-byte loop is unchanged; only the message-handling paths were reworked:

- **Message number read once.** `mesg.GetNum()` is now called once per message instead of up to twice.
- **No exception for missing developer IDs.** `descriptions.at(index)` threw and caught `std::out_of_range` when a field description had no developer data ID. It is now a `find` lookup with the same outcome.
- **Fewer copies.**
  - The field description is moved into the map when there is no description listener.
  - The developer data ID message is moved into `developers`. If that type has no move assignment, this simply falls back to a copy, so it is safe either way.
- **Same exception behavior.** The map write and the listener call stay inside a `try` that still swallows `std::out_of_range`. The catch is now by `const&`, which avoids copying the exception.
- **Same side effects.** `developers[index]` is still called through `operator[]`, so it inserts an entry when missing, as before.

The per-byte `pause` check must stay, because a listener can pause decoding mid-buffer. The gain is likely small, since the main per-byte cost sits in `ReadByte`, which this rewrite does not change.

```cpp
FIT_BOOL Decode::Resume(void)
{
    pause = FIT_FALSE;
    RETURN decodeReturn = RETURN_CONTINUE;

    do
    {
        if ( currentByteIndex == 0 )
        {
            file->read(buffer, BufferSize);
            bytesRead = (FIT_UINT32)file->gcount();
        }

        for (; currentByteIndex < bytesRead; currentByteIndex++)
        {
            if (pause)
                return FIT_FALSE;

            decodeReturn = ReadByte((FIT_UINT8)buffer[currentByteIndex]);

            if (decodeReturn == RETURN_CONTINUE)
            {
                currentByteOffset++;
                continue;
            }

            switch (decodeReturn) {
                case RETURN_MESG:
                {
                    const FIT_UINT16 num = mesg.GetNum();
                    if (num == FIT_MESG_NUM_DEVELOPER_DATA_ID)
                    {
                        DeveloperDataIdMesg devIdMesg(mesg);

                        if (!devIdMesg.IsDeveloperDataIndexValid()) {
                            throw fit::RuntimeException("Invalid developer data index in DeveloperDataIdMesg");
                        }

                        FIT_UINT8 index = devIdMesg.GetDeveloperDataIndex();
                        developers[index] = std::move(devIdMesg);
                        descriptions[index] = std::unordered_map<FIT_UINT8, FieldDescriptionMesg>();
                    }
                    else if (num == FIT_MESG_NUM_FIELD_DESCRIPTION)
                    {
                        FieldDescriptionMesg descMesg(mesg);

                        if (!descMesg.IsDeveloperDataIndexValid()) {
                            throw fit::RuntimeException("Invalid developer data index in FieldDescriptionMesg");
                        }

                        if (!descMesg.IsFieldDefinitionNumberValid())
                        {
                            throw fit::RuntimeException("Invalid developer field definition number in FieldDescriptionMesg");
                        }

                        FIT_UINT8 index = descMesg.GetDeveloperDataIndex();
                        FIT_UINT8 fldNum = descMesg.GetFieldDefinitionNumber();

                        auto it = descriptions.find(index);
                        if (it != descriptions.end())
                        {
                            try
                            {
                                if (descriptionListener)
                                {
                                    it->second[fldNum] = descMesg;
                                    descriptionListener->OnDeveloperFieldDescription(DeveloperFieldDescription(descMesg, developers[index]));
                                }
                                else
                                {
                                    it->second[fldNum] = std::move(descMesg);
                                }
                            }
                            catch (const std::out_of_range&)
                            {
                                // Description without a Developer Data Id Message
                            }
                        }
                    }

                    if (mesgListener)
                        mesgListener->OnMesg(mesg);
                    break;
                }

                case RETURN_MESG_DEF:
                    if (mesgDefinitionListener)
                    {
                        mesgDefinitionListener->OnMesgDefinition(localMesgDefs[localMesgIndex]);
                    }
                    break;

                case RETURN_END_OF_FILE:
                    // Increment so we do not read the same byte twice in the case of a chained file
                    currentByteIndex++;
                    currentByteOffset++;
                    return FIT_TRUE;

                default:
                    currentByteOffset++;
                    return FIT_TRUE;
            }
            currentByteOffset++;
        }
        currentByteIndex = 0;
    } while ( file->good() );

    if ((streamIsComplete == FIT_TRUE) && (skipHeader == FIT_FALSE))
    {
        // When decoding a complete file we should exit via RETURN_END_OF_FILE state only.
        std::ostringstream message;
        message << "FIT decode error: Unexpected end of input stream at byte: " << currentByteOffset;
        throw RuntimeException(message.str());
    }
    if (streamIsComplete == FIT_FALSE)
    {
        if ((decodeReturn == RETURN_MESG) || (decodeReturn == RETURN_MESG_DEF))
        {
            return FIT_TRUE;
        }
        else
        {
            return FIT_FALSE;
        }
    }
    else
    {
        if ((decodeReturn == RETURN_MESG) || (decodeReturn == RETURN_MESG_DEF))
        {
            return FIT_TRUE;
        }
        else
        {
            if (invalidDataSize == FIT_FALSE)
            {
                std::ostringstream message;
                message << "FIT decode error: Unexpected end of input stream at byte: " << currentByteOffset;
                throw RuntimeException(message.str());
            }
            else
            {
                return FIT_TRUE;
            }
        }
    }
}
```

