Main changes:
- `GetType()` is now called once instead of twice.
- When `sizeof(T)` equals the base-type size on a little-endian host, the value is read with a single `memcpy`. For these cases the result is bit-identical to the byte-by-byte shift loop.
- All other cases (size mismatch or a non-little-endian host) fall back to the original loop, reading through a raw pointer.

```cpp
template <typename T>
T FieldBase::GetValue(const FIT_UINT8 fieldArrayIndex) const
{
    const FIT_UINT8 typeNum = GetType() & FIT_BASE_TYPE_NUM_MASK;
    const FIT_UINT8 size = baseTypeSizes[typeNum];
    if (fieldArrayIndex >= (FIT_UINT8)values.size())
    {
        return *reinterpret_cast<const T*>(baseTypeInvalids[typeNum]);
    }

    const FIT_BYTE* p = values.data() + (static_cast<size_t>(fieldArrayIndex) * size);

#if defined(__BYTE_ORDER__) && defined(__ORDER_LITTLE_ENDIAN__) && (__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__)
    if (size == sizeof(T))
    {
        T out;
        std::memcpy(&out, p, sizeof(T));
        return out;
    }
#endif

    T rv = 0;

    for (int i = 0; i < size; i++)
    {
        rv |= static_cast<T>(p[i]) << (i * 8);
    }

    return rv;
}
```

