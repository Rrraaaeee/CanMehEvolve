File: src/fit_field_base.cpp
Function: FieldBase::GetNumValues
One decode of the test corpus takes about 359.528 ms.
The code below currently runs at 0.92453 of the original SDK's decode time; the best found so far is 0.92453.

Rewrite this function to make decoding faster:
```cpp
FIT_UINT8 FieldBase::GetNumValues(void) const
{
    if (!IsValid())
        return 0;

    const FIT_UINT8 type = GetType();

    if (type != FIT_BASE_TYPE_STRING)
    {
        const size_t n = values.size();
        const FIT_UINT8 sz = baseTypeSizes[type & FIT_BASE_TYPE_NUM_MASK];
        if (sz == 1)
            return (FIT_UINT8)n;
        return (FIT_UINT8)(n / sz);
    }

    return (FIT_UINT8)stringIndexes.size();
}
```
