This replaces the 128 KB lookup table with a 2 KB table for message numbers below 1024. The small table stays in cache, so lookups should be faster.

Message numbers of 1024 or more fall back to a linear scan. That scan returns the first matching entry, which is the same entry the old reverse-filled table picked. Unknown numbers still return `NULL`, so behavior is unchanged.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    enum { SMALL = 1024 };
    struct Index
    {
        FIT_UINT16 idx[SMALL];
        Index()
        {
            for (int k = 0; k < SMALL; k++)
                idx[k] = 0xFFFF;
            for (int i = MESGS - 1; i >= 0; i--)
            {
                if (mesgs[i].num < SMALL)
                    idx[mesgs[i].num] = (FIT_UINT16)i;
            }
        }
    };
    static const Index index;

    if (num < SMALL)
    {
        const FIT_UINT16 i = index.idx[num];
        if (i == 0xFFFF)
            return NULL;
        return &mesgs[i];
    }

    for (int i = 0; i < MESGS; i++)
    {
        if (mesgs[i].num == num)
            return &mesgs[i];
    }
    return NULL;
}
```