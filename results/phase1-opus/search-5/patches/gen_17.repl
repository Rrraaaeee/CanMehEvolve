The current version looks up a 128 KB table, which is mostly cache misses. This version uses a 2 KB table covering message numbers below 1024, which is where the profile's numbers fall, so it stays in cache.

- **Numbers below 1024:** the table stores the lowest matching index, which is the same first match the original returned.
- **Numbers of 1024 or more:** these fall back to a forward linear scan. It returns the first match, so behaviour is unchanged, including `NULL` when nothing matches.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    enum { TABLE_SIZE = 1024 };
    struct Index
    {
        FIT_UINT16 idx[TABLE_SIZE];
        Index()
        {
            for (int k = 0; k < TABLE_SIZE; k++)
                idx[k] = 0xFFFF;
            for (int i = MESGS - 1; i >= 0; i--)
            {
                if (mesgs[i].num < TABLE_SIZE)
                    idx[mesgs[i].num] = (FIT_UINT16)i;
            }
        }
    };
    static const Index index;

    if (num < TABLE_SIZE)
    {
        const FIT_UINT16 i = index.idx[num];
        if (i == 0xFFFF)
            return NULL;
        return &mesgs[i];
    }

    for (int i = 0; i < MESGS; i++)
    {
        if (mesgs[i].num == num)
            return &mesgs[i];
    }
    return NULL;
}
```