+class SmallBytes
+{
+public:
+    typedef FIT_BYTE* iterator;
+    typedef const FIT_BYTE* const_iterator;
+
+    SmallBytes() : ptr(small), count(0), capacityBytes(INLINE_BYTES) {}
+    SmallBytes(const SmallBytes& other) : ptr(small), count(0), capacityBytes(INLINE_BYTES)
+    {
+        if (other.count <= INLINE_BYTES)
+        {
+            // A heap buffer always holds more than INLINE_BYTES, so this read is in bounds.
+            std::memcpy(small, other.ptr, INLINE_BYTES);
+            count = other.count;
+        }
+        else
+        {
+            Reserve(other.count);
+            std::memcpy(ptr, other.ptr, other.count);
+            count = other.count;
+        }
+    }
+    SmallBytes(SmallBytes&& other) noexcept : ptr(small), count(other.count), capacityBytes(INLINE_BYTES)
+    {
+        if (other.ptr == other.small)
+        {
+            std::memcpy(small, other.small, INLINE_BYTES);
+        }
+        else
+        {
+            ptr = other.ptr;
+            capacityBytes = other.capacityBytes;
+            other.ptr = other.small;
+            other.capacityBytes = INLINE_BYTES;
+        }
+        other.count = 0;
+    }
+    SmallBytes& operator=(const SmallBytes& other)
+    {
+        if (this != &other)
+        {
+            Reserve(other.count);
+            std::memcpy(ptr, other.ptr, other.count);
+            count = other.count;
+        }
+        return *this;
+    }
+    ~SmallBytes() { if (ptr != small) delete[] ptr; }
+
+    size_t size() const { return count; }
+    bool empty() const { return count == 0; }
+    FIT_BYTE* data() { return ptr; }
+    const FIT_BYTE* data() const { return ptr; }
+    iterator begin() { return ptr; }
+    iterator end() { return ptr + count; }
+    const_iterator begin() const { return ptr; }
+    const_iterator end() const { return ptr + count; }
+    FIT_BYTE& operator[](size_t i) { return ptr[i]; }
+    const FIT_BYTE& operator[](size_t i) const { return ptr[i]; }
+    FIT_BYTE& back() { return ptr[count - 1]; }
+    const FIT_BYTE& back() const { return ptr[count - 1]; }
+    void clear() { count = 0; }
+
+    void push_back(FIT_BYTE value)
+    {
+        if (count == capacityBytes) Reserve(count * 2);
+        ptr[count++] = value;
+    }
+    void resize(size_t newSize)
+    {
+        Reserve(newSize);
+        if (newSize > count) std::memset(ptr + count, 0, newSize - count);
+        count = (FIT_UINT32)newSize;
+    }
+    void assign(const FIT_BYTE* first, const FIT_BYTE* last)
+    {
+        const size_t n = (size_t)(last - first);
+        Reserve(n);
+        if (n != 0) std::memcpy(ptr, first, n);
+        count = (FIT_UINT32)n;
+    }
+    iterator erase(iterator first, iterator last)
+    {
+        std::memmove(first, last, (size_t)(end() - last));
+        count -= (FIT_UINT32)(last - first);
+        return first;
+    }
+    iterator insert(iterator position, FIT_BYTE value)
+    {
+        const size_t at = (size_t)(position - ptr);
+        if (count == capacityBytes) Reserve(count * 2);
+        std::memmove(ptr + at + 1, ptr + at, count - at);
+        ptr[at] = value;
+        count++;
+        return ptr + at;
+    }
+    void insert(iterator position, const FIT_BYTE* first, const FIT_BYTE* last)
+    {
+        const size_t at = (size_t)(position - ptr);
+        const size_t n = (size_t)(last - first);
+        Reserve(count + n);
+        if (n == 0) return;
+        std::memmove(ptr + at + n, ptr + at, count - at);
+        std::memcpy(ptr + at, first, n);
+        count += (FIT_UINT32)n;
+    }
+
+private:
+    enum { INLINE_BYTES = 16 };
+
+    void Reserve(size_t wanted)
+    {
+        if (wanted <= capacityBytes) return;
+        FIT_BYTE* grown = new FIT_BYTE[wanted];
+        std::memcpy(grown, ptr, count);
+        if (ptr != small) delete[] ptr;
+        ptr = grown;
+        capacityBytes = (FIT_UINT32)wanted;
+    }
+
+    FIT_BYTE* ptr;
+    FIT_UINT32 count;
+    FIT_UINT32 capacityBytes;
+    FIT_BYTE small[INLINE_BYTES];
+};
